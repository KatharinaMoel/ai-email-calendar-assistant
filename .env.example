# Copy this file to .env and replace the placeholder values.

# Nylas
NYLAS_API_KEY=your_nylas_api_key_here
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_CLIENT_ID=your_nylas_client_id_here
NYLAS_GRANT_ID=your_nylas_grant_id_here
NYLAS_WEBHOOK_SECRET=your_nylas_webhook_secret_here

# Application
EMAIL=you@example.com
SERVER_URL=https://your-public-webhook-url.example

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL
POSTGRES_USER=ai_assistant
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_assistant
DATABASE_URL=postgresql://ai_assistant:change_me@localhost:5432/ai_assistant
